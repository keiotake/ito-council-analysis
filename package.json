{
  "name": "ito-council-analysis",
  "version": "1.0.0",
  "description": "みんなの伊東市 - 伊東市議会の議論をAIで整理した非公式情報サイト",
  "private": true,
  "scripts": {
    "build": "node build_v3.js",
    "monthly": "node monthly_check.js",
    "audit": "node audit.js",
    "audit:strict": "node audit.js --strict",
    "audit:json": "node audit.js --json",
    "audit:approve-all": "node audit.js --approve-all",
    "audit:show-all": "node audit.js --show-allowlisted",
    "scrape:list": "node scrape_minutes.js",
    "scrape:new": "node scrape_new_only.js",
    "parse": "node parse_minutes.js",
    "integrate": "node integrate_gijiroku.js",
    "deploy:worker": "cd voice-backend && npx wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
